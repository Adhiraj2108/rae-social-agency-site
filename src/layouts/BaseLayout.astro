---
import HeadCode from '../components/global/HeadCode.astro';
import { WEBFLOW_SITE_ID } from '../data/seo';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path under /public or absolute URL. */
  ogImage?: string;
  /** Webflow page id. webflow.js uses it to scope IX3 interactions. */
  wfPage: string;
  /** Keep the page out of search results (e.g. the style guide). */
  noindex?: boolean;
}

const { title, description, ogTitle = title, ogDescription = description, ogImage, wfPage, noindex = false } = Astro.props;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<html data-wf-page={wfPage} data-wf-site={WEBFLOW_SITE_ID} lang="en">
  <head>
    <meta charset="utf-8"/>
    <title>{title}</title>
    <meta content={description} name="description"/>
    <meta content={ogTitle} property="og:title"/>
    <meta content={ogDescription} property="og:description"/>
    {ogImageUrl && <meta content={ogImageUrl} property="og:image"/>}
    <meta content={ogTitle} name="twitter:title"/>
    <meta content={ogDescription} name="twitter:description"/>
    <meta property="og:type" content="website"/>
    <meta content="summary_large_image" name="twitter:card"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    {noindex && <meta name="robots" content="noindex"/>}
    <link href="/css/webflow.css" rel="stylesheet" type="text/css"/>
    <link href="/css/custom.css" rel="stylesheet" type="text/css"/>
    <style is:inline>html.w-mod-js:not(.w-mod-ix3) :is([data-animate="stagger-children"] > *) {visibility: hidden !important;}</style>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/webflow-favicon.ico" rel="shortcut icon" type="image/x-icon"/>
    <link href="/images/webflow-webclip.png" rel="apple-touch-icon"/>
    <slot name="head-schema" />
    <HeadCode />
    <script is:inline src="/js/site/project-drawer.js" defer></script>
    <slot name="head-end" />
    <script is:inline src="/js/site/linereveal-1.2.0.js" type="text/javascript"></script>
  </head>
  <body>
    <slot />
    <script is:inline src="/js/vendor/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow/webflow.schunk.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow/webflow.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/gsap/3.15.0/gsap.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/gsap/3.15.0/SplitText.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/gsap/3.15.0/ScrollTrigger.min.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">gsap.registerPlugin(SplitText,ScrollTrigger);</script>
    <script is:inline>

  // Lenis
const lenis = new Lenis({
  autoRaf: true,
});
  
</script>
    <!-- Hero loader controller. Markup: src/components/home/Loader.astro -->
    <script is:inline src="/js/site/loader-controller.js"></script>
    <slot name="footer-page" />
    <script is:inline src="/js/site/copyemail-1.0.0.js" type="text/javascript"></script>
    <slot name="footer-end" />
  </body>
</html>
